# Domains for automatic HTTPS. Point both A records here, DNS-only so the ACME challenge lands.
OSMSG_FRONTEND_DOMAIN=osmsg.osgeonepal.org
OSMSG_API_DOMAIN=api.osmsg.osgeonepal.org
OSMSG_ACME_EMAIL=admin@osgeonepal.org

# Worker cold start (no resume state): begins at day granularity and --update auto-refines to hour then
# minute as the backlog shrinks. OSMSG_BOOTSTRAP_DAYS sets the cold-start window (default 1 day).
# OSMSG_SCHEDULE=*/2 * * * *
# OSMSG_BOOTSTRAP_DAYS=1
# OSMSG_CHANGESET_PAD_HOURS=24

# Cap each --update tick to this many hours of diffs so a large backlog catches up over successive
# ticks, each committing its slice, instead of accumulating the whole gap in one pass. Unset = off.
OSMSG_MAX_UPDATE_WINDOW_HOURS=24

# Postgres DSN for the monthly prune (drops rows now covered by published history). Same db as the
# worker; the prune runs inside the compose network.
# OSMSG_PSQL_DSN=postgresql://osmsg:osmsg@db:5432/osmsg

# DuckDB memory safety on a capped container: bound the limit and spill to the block
# volume so a large merge spills to disk instead of aborting out-of-memory.
# OSMSG_DUCKDB_MEMORY_LIMIT=1GB
# OSMSG_DUCKDB_THREADS=2
# OSMSG_DUCKDB_TEMP_DIR=/var/cache/osmsg/duckdb-tmp

# Geofabrik country replication only.
# OSM_USERNAME=
# OSM_PASSWORD=

# Applied every tick. Never set --url here: a pinned --url minute over a large gap fills the disk.
OSMSG_EXTRA_ARGS=--name stats --output-dir /var/lib/osmsg --cache-dir /var/cache/osmsg --format psql --psql-dsn postgresql://osmsg:osmsg@db:5432/osmsg --all

# Country example (needs OSM credentials):
# OSMSG_EXTRA_ARGS=--name nepal --output-dir /var/lib/osmsg --cache-dir /var/cache/osmsg --country nepal --format psql --psql-dsn postgresql://osmsg:osmsg@db:5432/osmsg --all
