[Unit]
Description=osmsg stub-changeset backfill (fill metadata the changesets feed dropped)
Requires=docker.service
After=docker.service network-online.target osmsg.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/osmsg/infra
EnvironmentFile=/opt/osmsg/infra/.env
ExecStart=/opt/osmsg/infra/run-check.sh
TimeoutStartSec=1800
